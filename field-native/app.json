{
  "expo": {
    "name": "NPF SitRep Field",
    "slug": "field-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fieldnative",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1628"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "minSdkVersion": 29,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0a1628"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "package": "com.npfsitrep.field"
    },
    "extra": {
      "apiBaseUrl": "http://66.45.231.142:5530"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow NPF SitRep Field to attach your GPS position to reports, evidence and safety check-ins."
        }
      ]
    ],
    "runtimeVersion": "1.0.0",
    "updates": {
      "enabled": true,
      "url": "http://66.45.231.142:5530/api/ota/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
