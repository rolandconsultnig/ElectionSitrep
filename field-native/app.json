{
  "expo": {
    "name": "NPF SitRep Field",
    "slug": "field-native",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fieldnative",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1628"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "minSdkVersion": 29,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0a1628"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "package": "com.npfsitrep.field",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "extra": {
      "apiBaseUrl": "https://66.45.231.142:6634"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "kotlinVersion": "2.1.20"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow NPF SitRep Field to attach your GPS position to reports, evidence and safety check-ins."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NPF SitRep Field to make video calls to the Situation Room and capture evidence photos."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow NPF SitRep Field to use the microphone for voice/video calls and audio evidence."
        }
      ]
    ],
    "runtimeVersion": "1.1.0",
    "updates": {
      "enabled": true,
      "url": "https://66.45.231.142:6634/api/ota/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
