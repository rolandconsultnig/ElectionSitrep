{
  "name": "election-sitrep",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "concurrently --kill-others -n api,web -c blue,green \"npm run start --prefix server\" \"npm run preview --prefix sitrep-app\"",
    "build": "npm run build --prefix sitrep-app",
    "build:web": "npm run build --prefix sitrep-app",
    "seed:test-users": "npm run seed:test-users --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
