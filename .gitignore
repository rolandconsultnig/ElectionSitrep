# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies & builds
**/node_modules/
**/dist/
**/web-build/
.expo/

# Android — machine-local SDK path & build caches (never commit)
**/android/local.properties
**/android/.gradle/
**/android/app/build/
**/android/build/

# Field app — release APKs built locally (do not commit)
field-native/releases/

# Local scratch / tooling folders (not part of repo)
/XNPF/

# Generated decks — rebuild with scripts/generate_*presentation.py
# (sitrep-app/public/NPF_National_Command_Directory.pptx is committed: it is
#  served as a download link by NpfCommandDirectoryView)
/ElectionSitrep_Executive_Presentation.pptx
/NPF_National_Command_Directory.pptx
sitrep-app/public/ElectionSitrep_Executive_Presentation.pptx

# tesseract.js downloads the OCR language model into cwd on first run
server/*.traineddata

# Logs & OS
*.log
npm-debug.*
.DS_Store
Thumbs.db
/ota/
field-native/dist-ota/

# Downloaded APKs served by /downloads route (do not commit — 159 MB binary)
/downloads/
